#!/usr/bin/expect -f

# This script wraps the 'claude' CLI and automatically sends "y" whenever it sees a permission prompt.

# Disable timeout so the script doesn't exit when idle
set timeout -1

# Spawn the original claude CLI, passing any arguments you provide (e.g. claude-yes -p "my prompt")
spawn claude {*}$argv

# Propagate terminal resize events to the spawned pty.
# Without this, claude keeps using the terminal size it started with,
# so resizing the window scrambles its TUI rendering.
trap {
    set rows [stty rows]
    set cols [stty columns]
    stty rows $rows columns $cols < $spawn_out(slave,name)
} WINCH

# Start the interactive session
interact {
    # -o tells expect to match against the OUTPUT of claude, not your input
    -o
    # Match the whole permission menu, anchored on its final "N. No" line so that
    # by the time the pattern fires, any "don't ask again" option has already
    # streamed in and is included in $interact_out(buffer).
    -re {(?i)Do you want to proceed\?.*\n\s*[0-9]+\. No} {
        sleep 0.2
        # Some prompts offer a middle option, "Yes, and don't ask again for: ...".
        # When present, prefer it so the permission is whitelisted going forward.
        # Otherwise (plain "1. Yes" / "2. No"), fall back to the default "1. Yes".
        if {[string match "*don't ask again*" $interact_out(buffer)]} {
            send "2\r"
        } else {
            send "\r"
        }
    }
}
