#!/usr/bin/expect -f

# This script wraps the 'claude' CLI and automatically sends "y" whenever it sees a permission prompt.

# Disable timeout so the script doesn't exit when idle
set timeout -1

# Spawn the original claude CLI, passing any arguments you provide (e.g. claude-yes -p "my prompt")
spawn claude {*}$argv

# Sync the spawned pty's dimensions to the controlling terminal's current size.
# Without this, claude renders its TUI using the pty's default/stale size until
# something (e.g. a manual window resize) forces it to redraw, which can hide
# or scramble menus like the permission prompt below.
proc sync_pty_size {} {
    global spawn_out
    # Swallow failures: if there's no real controlling terminal to read a size
    # from (e.g. a non-interactive invocation), just leave the pty at its
    # default size instead of crashing the wrapper.
    catch {
        set rows [stty rows]
        set cols [stty columns]
        if {$rows > 0 && $cols > 0} {
            stty rows $rows columns $cols < $spawn_out(slave,name)
        }
    }
}

# Apply once immediately so claude starts with the correct size from its very
# first frame, then keep re-applying on every subsequent resize (SIGWINCH).
sync_pty_size
trap { sync_pty_size } WINCH

# Start the interactive session
interact {
    # -o tells expect to match against the OUTPUT of claude, not your input
    -o
    # Trigger on the prompt header alone. Claude's full-screen TUI renders the
    # options below it (and often words within the same sentence) using
    # per-word cursor-positioning and color-reset escape codes rather than
    # plain contiguous text or literal "\n" bytes - e.g. the option line is
    # actually "2. " + ESC[39m + "No", not "2. No" - so a literal multi-word
    # match against the full menu is unreliable. This short header phrase was
    # confirmed to render intact in captured real sessions.
    -re {(?i)Do you want to proceed\?} {
        # Give the rest of the menu (options, and any "don't ask again"
        # variant) time to stream in before deciding how to respond.
        sleep 0.3
        # Strip ANSI escape codes before the substring check below, so a
        # color/cursor code landing inside or next to a word can't hide it.
        regsub -all {\x1b\[[0-9;?]*[a-zA-Z]} $interact_out(buffer) {} cleaned
        # Some prompts offer a middle option, "Yes, and don't ask again for: ...".
        # When present, prefer it so the permission is whitelisted going forward.
        # Otherwise (plain "1. Yes" / "2. No"), fall back to the default "1. Yes".
        if {[string match "*don't ask again*" $cleaned]} {
            send "2\r"
        } else {
            send "\r"
        }
    }
    # The one-time "workspace trust" prompt shown for a new/untrusted directory
    # uses completely different wording ("Enter to confirm · Esc to cancel", not
    # "Do you want to proceed?") and renders most of its text with a cursor-jump
    # escape code between every word (position depends on terminal width), so
    # multi-word phrases can't be matched literally. "Accessing" and "workspace"
    # are the two words in its header, close enough together to bridge with a
    # bounded wildcard regardless of width. The cursor already defaults to
    # "1. Yes, I trust this folder", so a plain Enter accepts it.
    -re {(?i)Accessing.{0,40}workspace} {
        sleep 0.2
        send "\r"
    }
}
